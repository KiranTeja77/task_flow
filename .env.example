# Copy to .env and adjust. All values have working defaults for local use.

# Database
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

# Backend
JWT_SECRET=change-me-please-use-a-long-random-secret-key-32bytes

# Shown in the UI footer (Jenkins overrides BUILD_NUMBER and GIT_COMMIT)
APP_VERSION=1.0
BUILD_NUMBER=local
GIT_COMMIT=unknown

# Image names/tags (Jenkins sets IMAGE_TAG to the build number)
DOCKERHUB_USER=yourdockerhubuser
IMAGE_TAG=latest

# Ports on the host
FRONTEND_PORT=3000
BACKEND_PORT=8090
